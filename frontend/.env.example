# Public values only: anything here can reach the browser. Never put secrets in this file.
NEXT_PUBLIC_APP_NAME=Converso

# Server-side only (not exposed to the browser): where the backend API runs.
API_URL=http://localhost:4000
# Landing page "Contact us": a https://wa.me/<number> link, a mailto: or a form URL. Unset = scrolls to the end of the page.
NEXT_PUBLIC_CONTACT_URL=
