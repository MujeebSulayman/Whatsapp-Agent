generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  owner
  agent
}
enum ConversationStatus {
  ai
  human
  closed
}
enum Direction {
  inbound
  outbound
}
enum MessageType {
  text
  audio
  image
  interactive
}
enum SentBy {
  ai
  human
  customer
}
enum OrderStatus {
  pending
  paid
  dispatched
  delivered
  cancelled
}
enum PaymentStatus {
  unpaid
  pending
  paid
  failed
  refunded
}
enum PaymentProvider {
  paystack
  flutterwave
}

/// How a business sells: stocked products, services (quotes and bookings), or both.
enum BusinessKind {
  goods
  services
  both
}

// Money is an integer count of the currency minor unit (cents, kobo, pence...), never floats. Each business has one currency.

model Business {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  category      String
  city          String   @default("")
  country       String   @default("NG")
  currency      String   @default("NGN")
  kind          BusinessKind @default(goods)
  timezone      String   @default("Africa/Lagos")
  plan          String   @default("trial")
  aiEnabled     Boolean  @default(true) @map("ai_enabled")
  tone          String   @default("friendly")
  businessHours Json?    @map("business_hours")
  paymentInfo   String?  @map("payment_info")
  returnPolicy  String?  @map("return_policy")
  ownerPhone    String?  @map("owner_phone")
  trialEndsAt   DateTime? @map("trial_ends_at")
  aiDailyCapUsd Decimal  @default(5) @map("ai_daily_cap_usd") @db.Decimal(10, 2)
  /// Paystack subaccount: where this business's share of card/bank payments is settled. Null = payments not set up.
  paystackSubaccountCode String? @map("paystack_subaccount_code")
  payoutBankName     String? @map("payout_bank_name")
  payoutAccountName  String? @map("payout_account_name")
  payoutAccountLast4 String? @map("payout_account_last4")
  createdAt     DateTime @default(now()) @map("created_at")

  memberships      Membership[]
  whatsappAccounts WhatsappAccount[]
  products         Product[]
  faqs             Faq[]
  deliveryZones    DeliveryZone[]
  aiRules          AiRules?
  customers        Customer[]
  conversations    Conversation[]
  orders           Order[]
  waitlistEntries WaitlistEntry[]
  media           Media[]
  playbooks       Playbook[]
  playbookRuns    PlaybookRun[]
  broadcasts       Broadcast[]
  usageLedger      UsageLedger[]
  auditLogs        AuditLog[]

  @@map("businesses")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  phone       String?
  name        String?
  passwordHash String?     @map("password_hash")
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]
  identities  AuthIdentity[]

  @@map("users")
}

model Membership {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  businessId String   @map("business_id")
  role       Role     @default(agent)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("memberships")
}

model WhatsappAccount {
  id                   String   @id @default(cuid())
  businessId           String   @map("business_id")
  wabaId               String   @map("waba_id")
  phoneNumberId        String   @unique @map("phone_number_id")
  displayNumber        String   @map("display_number")
  accessTokenEncrypted String   @map("access_token_encrypted")
  status               String   @default("active")
  createdAt            DateTime @default(now()) @map("created_at")
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("whatsapp_accounts")
}

model Product {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  name        String
  description String?
  priceMinor   Int      @map("price_minor")
  variants    Json?
  stockQty    Int      @default(0) @map("stock_qty")
  /// false for services and made-to-order items: availability is never limited by stock
  trackStock  Boolean  @default(true) @map("track_stock")
  imageUrls   String[] @map("image_urls")
  /// Owner-written note shown when sold out, e.g. "Back around 20 Dec". The AI may only repeat this, never invent a date.
  restockNote String?  @map("restock_note")
  /// Customers may order a sold-out item; it is recorded as a pre-order.
  allowPreorder Boolean @default(false) @map("allow_preorder")
  active      Boolean  @default(true)
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime @default(now()) @map("created_at")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  waitlist    WaitlistEntry[]

  @@index([businessId, active])
  @@map("products")
}

model Faq {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  question   String
  answer     String
  embedding  Unsupported("vector(1536)")?
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("faqs")
}

model DeliveryZone {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  areaName   String   @map("area_name")
  feeMinor    Int      @map("fee_minor")
  etaText    String   @map("eta_text")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, areaName])
  @@map("delivery_zones")
}

model AiRules {
  id                 String   @id @default(cuid())
  businessId         String   @unique @map("business_id")
  maxDiscountPct     Int      @default(0) @map("max_discount_pct")
  escalateKeywords   String[] @map("escalate_keywords")
  forbiddenTopics    String[] @map("forbidden_topics")
  customInstructions String?  @map("custom_instructions")
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("ai_rules")
}

model Customer {
  id                 String    @id @default(cuid())
  businessId         String    @map("business_id")
  waId               String    @map("wa_id")
  name               String?
  phone              String?
  tags               String[]
  notes              String?
  totalSpentMinor     Int       @default(0) @map("total_spent_minor")
  lastOrderAt        DateTime? @map("last_order_at")
  optedInMarketing   Boolean   @default(false) @map("opted_in_marketing")
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  orders             Order[]
  waitlist           WaitlistEntry[]
  playbookRuns       PlaybookRun[]

  @@unique([businessId, waId])
  @@map("customers")
}

model Conversation {
  id               String             @id @default(cuid())
  businessId       String             @map("business_id")
  customerId       String             @map("customer_id")
  status           ConversationStatus @default(ai)
  assignedTo       String?            @map("assigned_to")
  lastMessageAt    DateTime           @default(now()) @map("last_message_at")
  windowExpiresAt  DateTime?          @map("window_expires_at")
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages         Message[]
  agentRuns        AgentRun[]

  @@index([businessId, status, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  /// Monotonic insert order. createdAt can tie within a millisecond; seq never does.
  seq            Int          @unique @default(autoincrement())
  businessId     String       @map("business_id")
  conversationId String       @map("conversation_id")
  direction      Direction
  type           MessageType  @default(text)
  body           String?
  mediaUrl       String?      @map("media_url")
  transcript     String?
  waMessageId    String?      @unique @map("wa_message_id")
  status         String       @default("received")
  sentBy         SentBy       @map("sent_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([businessId])
  @@map("messages")
}

model Order {
  id              String        @id @default(cuid())
  businessId      String        @map("business_id")
  customerId      String        @map("customer_id")
  items           Json
  subtotalMinor    Int           @map("subtotal_minor")
  deliveryFeeMinor Int           @default(0) @map("delivery_fee_minor")
  discountMinor    Int           @default(0) @map("discount_minor")
  totalMinor       Int           @map("total_minor")
  address         String?
  notes           String?
  status          OrderStatus   @default(pending)
  paymentStatus   PaymentStatus @default(unpaid) @map("payment_status")
  createdAt       DateTime      @default(now()) @map("created_at")
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@index([businessId, status])
  @@map("orders")
}

model Payment {
  id          String          @id @default(cuid())
  businessId  String          @map("business_id")
  orderId     String          @map("order_id")
  provider    PaymentProvider @default(paystack)
  reference   String          @unique
  amountMinor  Int             @map("amount_minor")
  status      PaymentStatus   @default(pending)
  paidAt      DateTime?       @map("paid_at")
  rawWebhook  Json?           @map("raw_webhook")
  checkoutUrl String?         @map("checkout_url")
  createdAt   DateTime        @default(now()) @map("created_at")
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("payments")
}

model Broadcast {
  id               String    @id @default(cuid())
  businessId       String    @map("business_id")
  templateName     String    @map("template_name")
  audienceFilter   Json?     @map("audience_filter")
  scheduledAt      DateTime? @map("scheduled_at")
  sentCount        Int       @default(0) @map("sent_count")
  costEstimateMinor Int       @default(0) @map("cost_estimate_minor")
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("broadcasts")
}

model AgentRun {
  id             String       @id @default(cuid())
  businessId     String       @map("business_id")
  /// null for AI work that isn't a customer chat (setup help, assistant preview)
  conversationId String?      @map("conversation_id")
  /// chat | setup | preview: all of it counts towards the business's daily AI spend cap
  kind           String       @default("chat")
  model          String
  inputTokens    Int          @default(0) @map("input_tokens")
  outputTokens   Int          @default(0) @map("output_tokens")
  toolCalls      Json?        @map("tool_calls")
  latencyMs      Int          @default(0) @map("latency_ms")
  costUsd        Decimal      @default(0) @map("cost_usd") @db.Decimal(10, 6)
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("agent_runs")
}

model UsageLedger {
  id               String   @id @default(cuid())
  businessId       String   @map("business_id")
  period           String
  aiReplies        Int      @default(0) @map("ai_replies")
  waMessagesBilled Int      @default(0) @map("wa_messages_billed")
  metaCostUsd      Decimal  @default(0) @map("meta_cost_usd") @db.Decimal(10, 4)
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, period])
  @@map("usage_ledger")
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  actor      String
  action     String
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("audit_logs")
}

/// A sign-in method linked to a user besides their password (e.g. Google). provider + subject is unique platform-wide.
model AuthIdentity {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  provider  String
  subject   String
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

/// A customer who asked to be told when a sold-out item (or one of its variants) is back.
model WaitlistEntry {
  id         String    @id @default(cuid())
  businessId String    @map("business_id")
  productId  String    @map("product_id")
  /// null = the product as a whole; otherwise a variant name (size, colour)
  variant    String?
  customerId String    @map("customer_id")
  /// waiting | notified | cancelled. A customer can have only one waiting entry per product+variant.
  status     String    @default("waiting")
  createdAt  DateTime  @default(now()) @map("created_at")
  notifiedAt DateTime? @map("notified_at")
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, productId, status])
  @@map("waitlist_entries")
}

/// Photos the owner uploaded (product and option photos). Small, already shrunk by the browser. Behind MediaService so the
/// storage can move to object storage (R2/S3) later without touching anything else.
model Media {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  mime       String
  bytes      Bytes
  sizeBytes  Int      @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("media")
}

/// The owner's step-by-step way of handling one kind of customer (enquiry, intake, quote, viewing...). Works for any business.
model Playbook {
  id            String        @id @default(cuid())
  businessId    String        @map("business_id")
  name          String
  /// In the owner's words: when the assistant should use it
  whenToUse     String        @map("when_to_use")
  /// [{ id, ask, required }] in order
  steps         Json
  /// handoff = call the owner in with a summary; message = just send finishMessage
  finish        String        @default("handoff")
  finishMessage String?       @map("finish_message")
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at")
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  runs          PlaybookRun[]

  @@index([businessId, active])
  @@map("playbooks")
}

/// One customer going through a playbook, with what they told us.
model PlaybookRun {
  id             String    @id @default(cuid())
  businessId     String    @map("business_id")
  playbookId     String    @map("playbook_id")
  customerId     String    @map("customer_id")
  conversationId String?   @map("conversation_id")
  /// { stepId: answer }
  answers        Json      @default("{}")
  /// active | completed
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  playbook       Playbook  @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, status, createdAt])
  @@index([customerId, playbookId, status])
  @@map("playbook_runs")
}
