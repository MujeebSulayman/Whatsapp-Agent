# The app's database. Local Docker by default. On Neon use the pooled string (host contains -pooler) and keep ?sslmode=require.
DATABASE_URL=postgresql://wa:wa@localhost:5432/wa
# Optional. Used only by migrations (pnpm db:deploy). On Neon use the direct, non-pooled string. Leave empty locally.
DIRECT_URL=
REDIS_URL=redis://localhost:6379
PORT=4000
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# 64 hex chars: openssl rand -hex 32
WHATSAPP_TOKEN_ENCRYPTION_KEY=
WHATSAPP_DRY_RUN=true
SEED_PHONE_NUMBER_ID=
SEED_WHATSAPP_TOKEN=
# LLM via OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini
OPENROUTER_MODEL_SMART=openai/gpt-4o
# Online payments (Nigeria). Your platform's Paystack SECRET key: payments run through it and each business's share is settled to
# its own bank account via a Paystack subaccount. Set the webhook URL in Paystack to <API_PUBLIC_URL>/webhooks/paystack.
PAYSTACK_SECRET_KEY=
# Optional: your platform's cut of each payment, in percent (default 0).
PLATFORM_FEE_PCT=0

# Signs dashboard login tokens. Generate: openssl rand -hex 32
JWT_SECRET=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Sign in with Google (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to register: <API_PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
