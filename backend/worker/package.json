{
  "name": "@wa/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "chat": "tsx --env-file=../.env src/scripts/chat.ts",
    "eval": "tsx --env-file=../.env src/scripts/eval.ts",
    "embed:backfill": "tsx --env-file=../.env src/scripts/backfill-embeddings.ts"
  },
  "dependencies": {
    "@wa/agent": "workspace:*",
    "@wa/ai": "workspace:*",
    "@wa/db": "workspace:*",
    "@wa/shared": "workspace:*",
    "@wa/whatsapp": "workspace:*",
    "bullmq": "^6.7.10",
    "ioredis": "^6.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "dotenv": "^18.0.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
