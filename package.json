{
  "name": "wa-sales-agent",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "infra:up": "docker compose -f backend/docker-compose.yml up -d",
    "infra:down": "docker compose -f backend/docker-compose.yml down",
    "db:migrate": "pnpm --filter @wa/db db:migrate",
    "app:up": "docker compose -f backend/docker-compose.yml --profile app up -d --build",
    "app:down": "docker compose -f backend/docker-compose.yml --profile app down"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
